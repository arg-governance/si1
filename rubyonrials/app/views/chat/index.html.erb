<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= content_for?(:title) ? yield(:title) : "SI-1 Chat Demo" %></title>
    <style>
        body { font-family: sans-serif; margin: 2em; }
        #chat-log { border: 1px solid #ccc; padding: 1em; height: 400px; overflow-y: auto; margin-bottom: 1em; }
        #input-box { width: 80%; padding: 0.5em; font-size: 1em; }
        #send-btn { padding: 0.5em 1em; font-size: 1em; }
        .user { color: blue; }
        .bot { color: green; }
        .system { color: gray; font-style: italic; white-space: pre-wrap; }
    </style>
</head>
<body>
    <h1><%= yield(:heading) || "SI-1 Chat Demo" %></h1>
    <div id="chat-log"></div>
    <input type="text" id="input-box" placeholder="Ask SI-1...">
    <button id="send-btn">Send</button>

    <script>
        const log = document.getElementById('chat-log');
        const input = document.getElementById('input-box');
        const btn = document.getElementById('send-btn');

        function appendMessage(sender, text, className) {
            const div = document.createElement('div');
            div.className = className;
            const label = document.createElement('strong');
            label.textContent = `${sender}: `;
            div.append(label, document.createTextNode(text));
            log.appendChild(div);
            log.scrollTop = log.scrollHeight;
        }

        btn.addEventListener('click', async () => {
            const prompt = input.value.trim();
            if (!prompt) return;
            appendMessage('You', prompt, 'user');
            input.value = '';

            try {
                const resp = await fetch('/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prompt })
                });
                const data = await resp.json();
                if (!resp.ok) throw new Error(data.error || `HTTP ${resp.status}`);
                if (data.trace) appendMessage('SI-1 phase trace', data.trace, 'system');
                appendMessage('SI-1', data.response, 'bot');
                if (data.reject_reason) {
                    appendMessage('System', `Gate rejected: ${data.reject_reason}`, 'system');
                }
            } catch (e) {
                appendMessage('System', `Error: ${e}`, 'system');
            }
        });

        input.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') btn.click();
        });
    </script>
</body>
</html>